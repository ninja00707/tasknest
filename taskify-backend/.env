PORT=5050

# ── Database ──────────────────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=taskify
DB_PASSWORD=Qasim@11
DB_PORT=5432
DB_POOL_MAX=20           # Max concurrent pool connections (per worker)
DB_IDLE_TIMEOUT=30000    # 30s idle timeout
DB_CONN_TIMEOUT=5000     # 5s connection timeout

# ── Redis / Cache ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://:password@localhost:6379
CACHE_TTL_SEC=300        # Default cache TTL (5 min)
CACHE_TICKETS_TTL=60     # Ticket list cache TTL (1 min)
CACHE_STATS_TTL=120      # Dashboard stats cache TTL (2 min)

# ── Server ───────────────────────────────────────────────────────────
JWT_SECRET=mysecret
WORKERS=auto             # Cluster workers (auto = CPU count, or set a number)
RATE_LIMIT_MAX=300       # Max requests/min per IP (API endpoints)
MAX_FILE_SIZE=5242880    # Max upload size (5 MB)

# ── Queue ─────────────────────────────────────────────────────────────
QUEUE_ENABLED=true